# Credenciales NovusBet BackOffice
BO_USERNAME=FinanceSV
BO_PASSWORD=Anma07covi*

# Fechas de exportación (YYYY-MM-DD)
START_DATE=2026-09-01
END_DATE=2026-09-07

# Producto Causal a consultar (ID del producto)
CAUSAL_PRODUCT_ID=

# ============================================
# SUPABASE - Base de Datos PostgreSQL
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_TABLE=transaction_records
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# GOOGLE LOOKER STUDIO - Conexión Directa
# ============================================
# Estos datos se usan para conectar Looker con Supabase
LOOKER_CONNECTOR_ID=your-connector-id
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# ============================================
# CONFIGURACIÓN DE SINCRONIZACIÓN
# ============================================
# Intervalo de sincronización automática en minutos
SYNC_INTERVAL_MINUTES=30
# Activa logs detallados
DEBUG=false
